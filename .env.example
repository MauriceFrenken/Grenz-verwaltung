# Grenz & Co. Verwaltung — Umgebungsvariablen (Kopie nach .env.local bzw. Vercel Env)
# Alles ohne VITE_-Präfix bleibt serverseitig.

# Supabase (eigenes Grenz-Projekt)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Produktions-Origin der App, z. B. https://grenz-verwaltung.vercel.app
# (feste Salesforce-Callback-Domain; Previews melden sich darüber an)
VITE_APP_ORIGIN=

# Anthropic (KI-Analyse von Exposés und Postfach-Anhängen)
ANTHROPIC_API_KEY=

# Salesforce (Exposé-Import → Salesforce)
VITE_SALESFORCE_CLIENT_ID=
# My Domain der Org, z. B. https://firma.my.salesforce.com
VITE_SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=

# Microsoft Graph — App-only (Client Credentials)
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
# Postfach für Offene Exposés
MICROSOFT_MAILBOX=
# Postfach für Dokumente › Postfach
MICROSOFT_POST_MAILBOX=
# Optional: zweites Postfach (dort wirkt auch die Outlook-Kategorie „ablegen“)
MICROSOFT_POST_MAILBOX_ZWEIT=
# Optional: aus dem zweiten Postfach nur Mails ab diesem Datum (ISO)
MICROSOFT_DOKUMENT_POSTEINGANG_SEIT=
# OneDrive-Benutzer der Dokumentenablage
MICROSOFT_ONEDRIVE_USER=
# Optional: nur diese OneDrive-Root-Ordner als Ablage (kommagetrennt)
MICROSOFT_ABLAGE_ROOT_ORDNER=
# Objektablage der Mandate (Mandatsakte › Überblick): Web-Link des Ordners „Grenz & Co (neu)“
# oder Benutzer + Pfad. Liegt der Ordner in einem anderen Tenant: dessen Tenant-Id; die App muss
# dort per Admin-Consent mit Files.Read.All (Application) freigegeben sein.
MICROSOFT_OBJEKTE_ORDNER_URL=
MICROSOFT_OBJEKTE_USER=
MICROSOFT_OBJEKTE_PFAD=
MICROSOFT_OBJEKTE_TENANT_ID=

# Vercel-Cron (Postfach-, Exposé- und EBICS-Nachtlauf)
CRON_SECRET=

# EBICS (≥16 Zeichen, verschlüsselt die Bankschlüssel)
EBICS_MASTER_KEY=

# Trello-Spiegel des Aufgabenboards (Hauptmenü › Aufgaben). API-Key und Secret unter
# https://trello.com/power-ups/admin (eigenes Power-Up), Token über den Link „Token“ dort.
# Board-ID = Kurzlink aus der Board-Adresse (trello.com/b/<ID>/…). Ohne diese Werte bleibt Trello aus.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_API_SECRET=
TRELLO_BOARD_ID=
